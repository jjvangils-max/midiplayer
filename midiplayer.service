[Unit]
Description=MIDI Player kiosk (touchscreen)
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/midiplayer
Environment=DISPLAY=:0
# Run inside the desktop session (X11). The kiosk was always started with
# DISPLAY=:0; forcing eglfs conflicts with the running GUI (EGL 0x3000).
Environment=QT_QPA_PLATFORM=xcb
Environment=QT_X11_NO_MITSHM=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/admin/midiplayer-venv/bin/python /home/admin/midiplayer/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
