[Unit]
Description=MIDI Player kiosk (touchscreen)
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/midiplayer
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/admin/midiplayer-venv/bin/python /home/admin/midiplayer/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
